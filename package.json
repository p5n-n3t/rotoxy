{
  "name": "rotoxy",
  "version": "0.2.0",
  "description": "ROTOXY: pooled AI gateways, distributed jobs, persistent supervision and private workers.",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "rotoxy": "scripts/rotoxy-control.mjs",
    "rotoxy-cli": "dist/cli.js"
  },
  "files": [
    "dist",
    "scripts/monitor-workforce.mjs",
    "assets/brand/*.svg",
    "docs",
    "supervisor/snooze/*.py",
    "supervisor/snooze/adapters/*.py",
    "supervisor/snooze/static/**",
    "supervisor/LICENSE",
    "supervisor/THIRD_PARTY_NOTICES.md",
    "supervisor/SECURITY.md",
    "supervisor/UPSTREAM.md",
    "supervisor/install.sh",
    "install.sh",
    "uninstall.sh",
    "LICENSE",
    "README.md",
    "SECURITY.md",
    "CHANGELOG.md",
    "scripts/rotoxy-control.mjs",
    "packaging/rotoxy*",
    "install-rotoxy.sh",
    "scripts/verify-recovery-continuity.py"
  ],
  "scripts": {
    "dev": "tsx src/cli.ts serve",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/cli.js serve",
    "test": "npm run build && node --test test/*.test.mjs",
    "check": "npm run build && npm test",
    "prepack": "npm run build"
  },
  "keywords": [
    "mcp",
    "oauth",
    "oauth2",
    "pkce",
    "chatgpt",
    "bearer-token",
    "reverse-proxy",
    "credential-pool",
    "tailscale",
    "funnel"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "commander": "^14.0.0",
    "express": "^5.1.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^24.0.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/p5n-n3t/rotoxy.git"
  }
}
