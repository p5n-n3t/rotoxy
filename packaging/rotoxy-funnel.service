[Unit]
Description=ROTOXY foreground Tailscale Funnel to ROTOXY on port 2030
After=network-online.target rotoxy.target rotoxy-gateway.service
Wants=rotoxy-gateway.service
# Keep the owned route during backend restarts; down stops Funnel explicitly.
PartOf=rotoxy.target

[Service]
Type=simple
ExecStart=/usr/bin/tailscale funnel --https=443 http://127.0.0.1:2030
Restart=no
TimeoutStopSec=10

# No [Install] section: this unit is never enabled for automatic boot exposure.
